# true = run with built-in demo data (no backend needed). false = call your real API.
# Base path of your API. With the Vite proxy, keep /api.
VITE_API_URL=/api
# Where the dev proxy forwards /api (FastAPI default shown).
VITE_PROXY_TARGET=http://localhost:8000
VITE_USE_MOCK=false
VITE_CURRENCY="PKR "
